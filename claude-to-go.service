### systemd unit for running claude-to-go as a service
###
### Install instructions:
###   1. Copy this file and update the placeholders below:
###      - Replace YOUR_USER with your username
###      - Replace /path/to/node with your node binary path (run `which node` to find it)
###   2. Copy to systemd:
###      sudo cp claude-to-go.service /etc/systemd/system/claude-to-go.service
###   3. Enable and start:
###      sudo systemctl daemon-reload
###      sudo systemctl enable --now claude-to-go.service
###
### Example paths:
### - If using nvm: /home/YOUR_USER/.nvm/versions/node/v18.18.0/bin/node
### - If using system node: /usr/bin/node

[Unit]
Description=claude-to-go web terminal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/claude-to-go

# Load environment variables from .env
EnvironmentFile=/home/YOUR_USER/claude-to-go/.env

# Run the server via node (update path as needed)
ExecStart=/path/to/node server.js

# Restart on failure
Restart=on-failure
RestartSec=5

# Only kill the node process, not tmux sessions (needed for session persistence)
KillMode=process

# Optional: set a nicer log identifier
SyslogIdentifier=claude-to-go

[Install]
WantedBy=multi-user.target
